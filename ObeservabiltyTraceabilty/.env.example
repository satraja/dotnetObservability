# Environment Variables Example File
# Copy this to .env and adjust values as needed

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Application Database
DB_NAME=ObservabilityTraceability
DB_USER=obstraceability
DB_PASSWORD=obstraceability123

# Application Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7000
ASPNETCORE_Kestrel__Certificates__Default__Path=/app/localhost.pfx
ASPNETCORE_Kestrel__Certificates__Default__Password=password

# Logging
LOG_LEVEL=Information

# Prometheus
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s
PROMETHEUS_RETENTION=15d

# Connection Strings
ConnectionStrings__PostgresConnection=Host=localhost;Database=ObservabilityTraceability;Username=obstraceability;Password=obstraceability123;Port=5432

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_PROMETHEUS_METRICS=true
ENABLE_ACTIVITY_LOGGING=true
